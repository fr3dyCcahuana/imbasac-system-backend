#!/usr/bin/python3 -I
"""Fixed privileged bridge: bounded JSON in, public certificate out, no arguments."""
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import stat
import sys
import uuid

MAX_REQUEST = 20000
CONFIGURATION = Path('/etc/imbasac/ca-signer.json')
HELPER = Path('/usr/local/lib/imbasac-ca/pki.py')
ERRORS = {'SIGN_REQUEST_INVALID': 2, 'SIGN_REQUEST_CONFLICT': 3, 'SIGN_BUSY': 4,
          'SIGN_STATE_UNCERTAIN': 5, 'SIGN_CONFIG_INVALID': 6, 'SIGN_FAILED': 7}


class SigningError(Exception):
    pass


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise SigningError('SIGN_REQUEST_INVALID')
        result[key] = value
    return result


def request_body(raw):
    try:
        if len(raw) > MAX_REQUEST:
            raise ValueError()
        body = json.loads(raw.decode('utf-8'), object_pairs_hook=unique_object)
        if not isinstance(body, dict) or not all(isinstance(value, str) for value in body.values()):
            raise ValueError()
        operation = body.get('operation', 'sign')
        expected = {'requestId', 'deviceId', 'certificatePem', 'operation'} if operation == 'revoke' else {'requestId', 'deviceId', 'csrPem'}
        if operation not in ('sign', 'revoke') or set(body) != expected:
            raise ValueError()
        body['requestId'] = str(uuid.UUID(body['requestId']))
        body['deviceId'] = str(uuid.UUID(body['deviceId']))
        if operation == 'sign':
            if len(body['csrPem']) > 16000 or not body['csrPem'].startswith('-----BEGIN CERTIFICATE REQUEST-----'):
                raise ValueError()
        else:
            pem = body['certificatePem']
            if len(pem) > 16000 or not pem.startswith('-----BEGIN CERTIFICATE-----') or not pem.strip().endswith('-----END CERTIFICATE-----') or pem.count('-----BEGIN') != 1:
                raise ValueError()
        body['operation'] = operation
        return body
    except (ValueError, UnicodeError, TypeError, AttributeError):
        raise SigningError('SIGN_REQUEST_INVALID') from None


def file_digest(body):
    document = {'deviceId': body['deviceId'], 'csrPem': body['csrPem']} if body['operation'] == 'sign' else {
        'operation': 'revoke', 'deviceId': body['deviceId'], 'certificatePem': body['certificatePem']}
    canonical = json.dumps(document, sort_keys=True, ensure_ascii=True)
    return hashlib.sha256(canonical.encode('ascii')).hexdigest()


def sync_file(path):
    # Windows FlushFileBuffers also requires write access; production is POSIX.
    with path.open('r+b') as stream:
        os.fsync(stream.fileno())
    if os.name == 'posix':
        descriptor = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def write_state(path, data, pki):
    pki.write_new(path, data)
    sync_file(path)


def installed_configuration():
    """Production only: caller cannot select a configuration or module path."""
    import pwd
    import grp
    ca_user = pwd.getpwnam('imbasac-ca')
    ca_group = grp.getgrnam('imbasac-ca')
    app_user = pwd.getpwnam('posapp')
    if os.geteuid() != ca_user.pw_uid or os.geteuid() == 0 or app_user.pw_gid == ca_group.gr_gid or 'posapp' in ca_group.gr_mem:
        raise SigningError('SIGN_CONFIG_INVALID')
    for path in (CONFIGURATION, HELPER, Path(__file__).absolute()):
        if path.is_symlink() or path.stat().st_uid != 0 or path.stat().st_mode & 0o022:
            raise SigningError('SIGN_CONFIG_INVALID')
        for parent in path.parents:
            if parent.is_symlink() or parent.stat().st_uid != 0 or parent.stat().st_mode & 0o022:
                raise SigningError('SIGN_CONFIG_INVALID')
    if CONFIGURATION.stat().st_gid != ca_group.gr_gid or CONFIGURATION.stat().st_mode & 0o007:
        raise SigningError('SIGN_CONFIG_INVALID')
    configuration = json.loads(CONFIGURATION.read_text('utf-8'), object_pairs_hook=unique_object)
    if not isinstance(configuration, dict) or set(configuration) != {'issuerDirectory', 'passphraseFile', 'outputDirectory'}:
        raise SigningError('SIGN_CONFIG_INVALID')
    for key in ('issuerDirectory', 'passphraseFile', 'outputDirectory'):
        path = Path(configuration[key])
        if not path.is_absolute() or path.is_symlink() or path.stat().st_uid != ca_user.pw_uid or path.stat().st_mode & 0o077:
            raise SigningError('SIGN_CONFIG_INVALID')
        if key == 'passphraseFile' and not path.is_file() or key != 'passphraseFile' and not path.is_dir():
            raise SigningError('SIGN_CONFIG_INVALID')
    return configuration


def trusted_helper():
    specification = importlib.util.spec_from_file_location('imbasac_ca_pki', HELPER)
    module = importlib.util.module_from_spec(specification)
    specification.loader.exec_module(module)
    return module


def certificate_response(certificate, csr, device, pki):
    # For retries retain exactly the original certificate, including after its
    # expiry; the application still decides whether it may be imported/used now.
    pem = certificate.read_text('ascii')
    if len(pem) > 16000 or pem.count('-----BEGIN CERTIFICATE-----') != 1 or not pem.startswith('-----BEGIN CERTIFICATE-----'):
        raise SigningError('SIGN_STATE_UNCERTAIN')
    if pki.run('x509', '-in', certificate, '-pubkey', '-noout') != pki.run('req', '-in', csr, '-pubkey', '-noout'):
        raise SigningError('SIGN_STATE_UNCERTAIN')
    san = pki.run('x509', '-in', certificate, '-ext', 'subjectAltName', '-noout').decode('ascii')
    if 'URI:urn:imbasac:device:' + device not in san:
        raise SigningError('SIGN_STATE_UNCERTAIN')
    return {'certificatePem': pem}


def process_request(raw, configuration, pki):
    """Injectable only as an imported test function; production paths are fixed."""
    body = request_body(raw)
    if body['operation'] == 'revoke':
        return process_revocation(body, configuration, pki)
    output_root = Path(configuration['outputDirectory']).resolve()
    digest = file_digest(body)
    try:
        with pki.locked(output_root):
            directory = output_root / body['requestId']
            if not directory.exists():
                directory.mkdir(mode=0o700)
                write_state(directory / 'request.json', json.dumps({'sha256': digest, 'deviceId': body['deviceId']}) + '\n', pki)
                write_state(directory / 'request.csr.pem', body['csrPem'], pki)
            stored = json.loads((directory / 'request.json').read_text('ascii'))
            if stored['sha256'] != digest:
                raise SigningError('SIGN_REQUEST_CONFLICT')
            csr = directory / 'request.csr.pem'
            certificate = directory / 'certificate.pem'
            if certificate.exists():
                return certificate_response(certificate, csr, body['deviceId'], pki)
            if (directory / 'signing.started').exists():
                # A killed signer can have changed the CA database. Never issue
                # another certificate blindly for the same request.
                raise SigningError('SIGN_STATE_UNCERTAIN')
            try:
                pki.validate_csr(csr)
            except ValueError:
                raise SigningError('SIGN_REQUEST_INVALID') from None
            write_state(directory / 'signing.started', 'CA operation started; preserve state for reconciliation\n', pki)
            pki.issue_device(configuration['issuerDirectory'], csr, body['deviceId'], certificate,
                             configuration['passphraseFile'], days=365)
            sync_file(certificate)
            return certificate_response(certificate, csr, body['deviceId'], pki)
    except FileExistsError:
        raise SigningError('SIGN_BUSY') from None
    except SigningError:
        raise
    except Exception:
        raise SigningError('SIGN_FAILED') from None


def process_revocation(body, configuration, pki):
    output_root = Path(configuration['outputDirectory']).resolve()
    digest = file_digest(body)
    try:
        with pki.locked(output_root):
            directory = output_root / body['requestId']
            if not directory.exists():
                directory.mkdir(mode=0o700)
                write_state(directory / 'request.json', json.dumps({'sha256': digest, 'operation': 'revoke', 'deviceId': body['deviceId']}) + '\n', pki)
                write_state(directory / 'certificate.pem', body['certificatePem'], pki)
            state = json.loads((directory / 'request.json').read_text('ascii'))
            if state['sha256'] != digest:
                raise SigningError('SIGN_REQUEST_CONFLICT')
            certificate = directory / 'certificate.pem'
            try:
                san = pki.run('x509', '-in', certificate, '-ext', 'subjectAltName', '-noout').decode('ascii')
                import re
                devices = re.findall(r'URI:urn:imbasac:device:([0-9a-fA-F-]{36})(?=\s|,|$)', san)
                if len(devices) != 1 or str(uuid.UUID(devices[0])) != body['deviceId']:
                    raise ValueError()
                pki.validate_revocation(configuration['issuerDirectory'], certificate)
            except ValueError:
                raise SigningError('SIGN_REQUEST_INVALID') from None
            # Recheck exact issuer/record and update its index under the CA lock.
            # Infrastructure errors here are retryable SIGN_FAILED, not bad input.
            pki.revoke(configuration['issuerDirectory'], certificate, configuration['passphraseFile'])
            if not (directory / 'revoked.done').exists():
                write_state(directory / 'revoked.done', 'OpenSSL CA recorded revocation; CRL publication is separate\n', pki)
            return {'revoked': True}
    except FileExistsError:
        raise SigningError('SIGN_BUSY') from None
    except SigningError:
        raise
    except Exception:
        raise SigningError('SIGN_FAILED') from None


def main():
    os.umask(0o077)
    try:
        if len(sys.argv) != 1:
            raise SigningError('SIGN_REQUEST_INVALID')
        # Do not inherit caller-controlled OPENSSL, PYTHONPATH, locale or HOME.
        os.environ.clear()
        os.environ.update({'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'OPENSSL': '/usr/bin/openssl', 'LC_ALL': 'C'})
        configuration = installed_configuration()
        raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
        response = process_request(raw, configuration, trusted_helper())
        sys.stdout.write(json.dumps(response, ensure_ascii=True) + '\n')
        return 0
    except SigningError as error:
        code = str(error)
        sys.stderr.write((code if code in ERRORS else 'SIGN_FAILED') + '\n')
        return ERRORS.get(code, 7)
    except Exception:
        sys.stderr.write('SIGN_CONFIG_INVALID\n')
        return ERRORS['SIGN_CONFIG_INVALID']


if __name__ == '__main__':
    raise SystemExit(main())
