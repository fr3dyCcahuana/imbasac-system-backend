[Unit]
Description=Validar y publicar CRL IMBASAC en Nginx
Requires=imbasac-device-crl-refresh.service
After=imbasac-device-crl-refresh.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/imbasac-ca/crl-publish
UMask=0077
TimeoutStartSec=60
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/imbasac/pki/public /var/log/nginx /run/nginx.pid
StandardOutput=journal
StandardError=journal
